# Ubuntu quick start: bash scripts/setup-docker.sh
# Then run: docker compose up -d --build --wait
# Or copy this file to .env and fill every secret. Never commit .env.
# Production: use HTTPS, APP_ENV=production and secure cookies.
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8080
# When changing WEB_PORT, also update the port in APP_URL.
WEB_PORT=8080
SESSION_SECURE_COOKIE=false
POSTGRES_PASSWORD=
# Compose provisions this limited role automatically, before running migrations.
# Keep its password separate from POSTGRES_PASSWORD (the database administrator).
APP_DB_USERNAME=eduquest_app
APP_DB_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Keep these ports on loopback; change them if another local stack uses them.
POSTGRES_PORT=55432
REDIS_PORT=56379
S3_PORT=59000
MAILPIT_SMTP_PORT=25125
MAILPIT_UI_PORT=58025
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notifications@example.test
EDUQUEST_EMAIL_NOTIFICATIONS=false
