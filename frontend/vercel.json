{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.nhatlonh.id.vn/api/:path*"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ]
}
